{
  "data_dir": "/var/lib/f2block",
  "sync_interval": 30,
  "geo_enabled": true,
  "geo_update_interval": 86400,
  "start_at_end": true,
  "rules": [
    {
      "name": "sshd",
      "log_file": "/var/log/auth.log",
      "max_retry": 3,
      "find_time": 3600,
      "pattern": "^(?P<time>\\S+|[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+\\S+\\s+sshd(?:-session)?\\[\\d+\\]: Failed (?:password|publickey) for (?:invalid user )?\\S+ from (?P<ip>\\S+) port \\d+(?: ssh\\d+)?(?: \\[preauth\\])?\\s*$"
    },
    {
      "name": "nginx-auth",
      "enabled": false,
      "log_file": "/var/log/nginx/access.log",
      "pattern": "^(?P<ip>\\S+) \\S+ \\S+ \\[(?P<time>[^\\]]+)\\] \"[^\"]*\" 401 \\d+(?: .*)?$",
      "time_format": "%d/%b/%Y:%H:%M:%S %z",
      "find_time": 300,
      "max_retry": 20
    }
  ]
}
